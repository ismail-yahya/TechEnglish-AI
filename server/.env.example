# ==============================================
# Langflow AI — Server Environment Variables
# ==============================================

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/Langflow?schema=public"

# Supabase
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# JWT
JWT_SECRET="change-this-to-a-strong-secret"
JWT_EXPIRES_IN="7d"

# Google Gemini API
GEMINI_API_KEY=""
GOOGLE_TRANSLATE_API_KEY=""
ASSEMBLYAI_API_KEY=""

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
# Supports multiple origins, comma-separated (no spaces)
# Example: http://localhost:5173,https://your-app.vercel.app
CLIENT_URL="http://localhost:5173"
